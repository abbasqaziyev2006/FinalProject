@using EcommerceCoza.BLL.ViewModels
@model IEnumerable<SliderViewModel>

@{
    ViewData["Title"] = "Slides";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content">
    <div class="main-content-inner">
        <div class="main-content-wrap">
            <div class="flex items-center flex-wrap justify-between gap20 mb-27">
                <h3 style="font-size:28px;">Slides</h3>
                <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
                    <li>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <div class="text-tiny">Dashboard</div>
                        </a>
                    </li>
                    <li><i class="icon-chevron-right"></i></li>
                    <li><div class="text-tiny">Slides</div></li>
                </ul>
            </div>

            <div class="wg-box">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div></div>
                    <a asp-area="Admin" asp-controller="Slider" asp-action="Create" class="btn btn-success">Add Slide</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-bordered mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width:120px">Image</th>
                                <th>Title</th>
                                <th>Line 1</th>
                                <th>Line 2</th>
                                <th style="width:90px">Active</th>
                                <th style="width:160px">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-secondary py-4">No slides found.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            @if (!string.IsNullOrEmpty(item.ImageName))
                                            {
                                                <img src="~/images/sliders/@item.ImageName" alt="@item.Title" style="max-height:80px; max-width:100%;" class="img-thumbnail">
                                            }
                                            else
                                            {
                                                <div class="text-muted">No image</div>
                                            }
                                        </td>
                                        <td class="align-middle">@item.Title</td>
                                        <td class="align-middle">@item.Line1</td>
                                        <td class="align-middle">@item.Line2</td>
                                        <td class="align-middle">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </td>
                                        <td class="align-middle">
                                            <a asp-area="Admin" asp-controller="Slider" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1">Edit</a>

                                            <form asp-area="Admin" asp-controller="Slider" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this slide?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}