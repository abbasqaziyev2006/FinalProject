@using EcommerceCoza.BLL.ViewModels
@model SliderCreateViewModel
@{
    ViewData["Title"] = "Create Slide";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content">
    <div class="main-content-inner">
        <div class="main-content-wrap">
            <!-- Header -->
            <div class="flex items-center flex-wrap justify-between gap20 mb-27">
                <h3>Slide</h3>
                <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
                    <li>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <div class="text-tiny">Dashboard</div>
                        </a>
                    </li>
                    <li><i class="icon-chevron-right"></i></li>
                    <li>
                        <a asp-area="Admin" asp-controller="Slider" asp-action="Index">
                            <div class="text-tiny">Slider</div>
                        </a>
                    </li>
                    <li><i class="icon-chevron-right"></i></li>
                    <li><div class="text-tiny">New Slide</div></li>
                </ul>
            </div>

            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Form -->
            <div class="wg-box">
                <form asp-area="Admin"
                      asp-controller="Slider"
                      asp-action="Create"
                      method="post"
                      enctype="multipart/form-data"
                      class="form-new-product form-style-1">

                    @Html.AntiForgeryToken()

                    <!-- Title -->
                    <fieldset class="name">
                        <div class="body-title">
                            Title <span class="tf-color-1">*</span>
                        </div>
                        <input asp-for="Title"
                               class="flex-grow"
                               type="text"
                               placeholder="Title"
                               tabindex="1"
                               aria-required="true"
                               required>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </fieldset>

                    <!-- Line 1 (Tagline) -->
                    <fieldset class="name">
                        <div class="body-title">
                            Line 1 <span class="tf-color-1">*</span>
                        </div>
                        <input asp-for="Line1"
                               class="flex-grow"
                               type="text"
                               placeholder="Line 1"
                               tabindex="2"
                               aria-required="true"
                               required>
                        <span asp-validation-for="Line1" class="text-danger"></span>
                    </fieldset>

                    <!-- Line 2 (Subtitle) -->
                    <fieldset class="name">
                        <div class="body-title">
                            Line 2 <span class="tf-color-1">*</span>
                        </div>
                        <input asp-for="Line2"
                               class="flex-grow"
                               type="text"
                               placeholder="Line 2"
                               tabindex="3"
                               aria-required="true"
                               required>
                        <span asp-validation-for="Line2" class="text-danger"></span>
                    </fieldset>

                    <!-- Image Upload -->
                    <fieldset>
                        <div class="body-title">
                            Upload images <span class="tf-color-1">*</span>
                        </div>
                        <div class="upload-image flex-grow">
                            <div class="item" id="imgpreview" style="display:none">
                                <img src="#" id="preview-img" class="effect8" alt="Slider Image Preview">
                            </div>
                            <div id="upload-file" class="item up-load">
                                <label class="uploadfile" for="ImageFile">
                                    <span class="icon">
                                        <i class="icon-upload-cloud"></i>
                                    </span>
                                    <span class="body-text">
                                        Drop your images here or select <span class="tf-color">click to browse</span>
                                    </span>
                                    <input type="file"
                                           asp-for="ImageFile"
                                           id="ImageFile"
                                           accept="image/*"
                                           tabindex="4"
                                           required>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </fieldset>

                    <!-- Link -->
                    <fieldset class="name">
                        <div class="body-title">Link</div>
                        <input asp-for="Link"
                               class="flex-grow"
                               type="text"
                               placeholder="https://example.com"
                               tabindex="5">
                        <span asp-validation-for="Link" class="text-danger"></span>
                    </fieldset>

                    <!-- Category Icon -->
                    <fieldset class="category">
                        <div class="body-title">Select category icon</div>
                        <div class="select flex-grow">
                            <select asp-for="CategoryIcon" class="">
                                <option value="">Select icon</option>
                                <option value="icon-1">icon 1</option>
                                <option value="icon-2">icon 2</option>
                            </select>
                        </div>
                    </fieldset>

                    <!-- Buttons -->
                    <div class="bot">
                        <div></div>
                        <button class="tf-button w208" type="submit" tabindex="6">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="bottom-page">
        <div class="body-text">Copyright © @DateTime.Now.Year SurfsideMedia</div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const uploadArea = document.getElementById('upload-file');
            const fileInput = document.getElementById('ImageFile');
            const imgPreview = document.getElementById('imgpreview');
            const previewImg = document.getElementById('preview-img');

            // Drag & Drop event handlers
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                uploadArea.addEventListener(eventName, preventDefaults, false);
                document.body.addEventListener(eventName, preventDefaults, false);
            });

            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }

            // Highlight effect on drag
            ['dragenter', 'dragover'].forEach(eventName => {
                uploadArea.addEventListener(eventName, highlight, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                uploadArea.addEventListener(eventName, unhighlight, false);
            });

            function highlight(e) {
                uploadArea.classList.add('drag-over');
            }

            function unhighlight(e) {
                uploadArea.classList.remove('drag-over');
            }

            // Handle dropped files
            uploadArea.addEventListener('drop', handleDrop, false);

            function handleDrop(e) {
                const dt = e.dataTransfer;
                const files = dt.files;

                if (files.length > 0) {
                    fileInput.files = files;
                    handleFiles(files[0]);
                }
            }

            // Handle file input change
            fileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    handleFiles(file);
                }
            });

            function handleFiles(file) {
                // Validate file type
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                if (!validTypes.includes(file.type)) {
                    alert('Please select a valid image file (JPEG, PNG, GIF, or WebP)');
                    fileInput.value = '';
                    return;
                }

                // Validate file size (max 5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB');
                    fileInput.value = '';
                    return;
                }

                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    imgPreview.style.display = 'block';
                    uploadArea.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }

            // Reset preview on form reset
            document.querySelector('form').addEventListener('reset', function() {
                imgPreview.style.display = 'none';
                uploadArea.style.display = 'block';
            });
        });
    </script>

    <style>
        .upload-image {
            border: 2px dashed #ddd;
            border-radius: 8px;
            padding: 20px;
            transition: border-color 0.3s;
        }

            .upload-image:hover {
                border-color: #007bff;
            }

        #upload-file.drag-over {
            border-color: #007bff;
            background-color: rgba(0, 123, 255, 0.1);
        }

        #imgpreview img {
            max-width: 100%;
            max-height: 300px;
            border-radius: 8px;
            object-fit: contain;
        }

        .text-danger {
            display: block;
            margin-top: 5px;
            font-size: 14px;
        }

        fieldset {
            margin-bottom: 20px;
        }

        .bot {
            display: flex;
            justify-content: flex-end;
            gap: 15px;
            margin-top: 30px;
        }

        .uploadfile {
            cursor: pointer;
        }

            .uploadfile input[type="file"] {
                position: absolute;
                opacity: 0;
                width: 100%;
                height: 100%;
                top: 0;
                left: 0;
                cursor: pointer;
            }
    </style>
}