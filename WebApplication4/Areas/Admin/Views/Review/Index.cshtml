@model List<ECommerceCoza.DAL.DataContext.Entities.Review>

@{
    ViewData["Title"] = "Reviews Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* ==== GLOBAL FIX ==== */
    html, body {
        overflow-x: visible !important;
    }

    .content-wrapper,
    .container-fluid {
        overflow-x: visible !important;
    }

    /* ==== TABLE SCROLL CONTAINER ==== */
    .custom-table-container {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        background: #fff;
        border-radius: 8px;
        position: relative;
    }

    /* ==== TABLE ==== */
    .table-custom-scroll {
        min-width: 1100px; /* Cədvəlin sıxılmaması üçün minimum genişlik */
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
    }

        .table-custom-scroll th,
        .table-custom-scroll td {
            padding: 12px 10px !important;
            font-size: 0.85rem;
            vertical-align: middle;
            border-bottom: 1px solid #edf2f7;
        }

    /* ==== PRODUCT NAME (Genişləndirildi) ==== */
    .product-box {
        width: 450px; /* Məhsul adının tam görünməsi üçün böyüdüldü */
        white-space: normal;
        word-break: break-word;
        font-weight: 600;
        color: #2d3748;
        line-height: 1.4;
    }

    
    .comment-box {
        width: 150px; 
        font-size: 0.8rem;
        color: #718096;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis; 
        white-space: nowrap;
    }

    .table-custom-scroll th:first-child,
    .table-custom-scroll td:first-child {
        position: sticky;
        left: 0;
        background: #fff;
        z-index: 3;
        width: 60px;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #667eea, #764ba2);
        padding: 15px 20px;
        color: white;
        border-radius: 12px 12px 0 0;
    }

    /* SCROLLBAR STYLING */
    .custom-table-container::-webkit-scrollbar {
        height: 6px;
    }

    .custom-table-container::-webkit-scrollbar-thumb {
        background: #cbd5e0;
        border-radius: 10px;
    }

    .btn-xs {
        padding: 4px 8px;
        font-size: 0.75rem;
    }
</style>

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-star mr-2"></i> Reviews Management
            </h5>
            <span class="badge badge-light">Total Items: @ViewBag.TotalItems</span>
        </div>

        <div class="card-body p-3">

            <div class="row mb-3">
                <div class="col-md-4">
                    <form method="get" class="input-group input-group-sm">
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Search by product or user...">
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="custom-table-container">
                    <table class="table table-hover table-custom-scroll">
                        <thead class="bg-light text-uppercase">
                            <tr>
                                <th>ID</th>
                                <th>Product Name</th>
                                <th style="width:150px">User</th>
                                <th style="width:120px">Rating</th>
                                <th>Comment</th>
                                <th style="width:150px" class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var review in Model)
                            {
                                <tr>
                                    <td class="text-muted">#@review.Id</td>

                                    <td>
                                        <div class="product-box">
                                            @(review.Product?.Name ?? "N/A")
                                            <div class="small text-muted" style="font-weight:400;">PID: @review.ProductId</div>
                                        </div>
                                    </td>

                                    <td>
                                        <div style="font-weight: 500;">@(review.AppUser?.UserName ?? "Anonymous")</div>
                                    </td>

                                    <td class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="fas fa-star @(i <= review.Rating ? "" : "text-light")"></i>
                                        }
                                        <small class="text-dark ml-1">(@review.Rating)</small>
                                    </td>

                                    <td>
                                        <div class="comment-box" title="@review.Comment">
                                            @review.Comment
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@review.Id" class="btn btn-xs btn-outline-info mr-1" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@review.Id" class="btn btn-xs btn-outline-warning mr-1" title="Edit Review">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@review.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-folder-open fa-3x mb-3"></i>
                    <p>No reviews found matching your criteria.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            
            $('[title]').tooltip();
        });
    </script>
}