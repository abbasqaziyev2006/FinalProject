@model List<EcommerceCoza.BLL.ViewModels.ProductVariantViewModel>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th style="width: 100px;">Image</th>
                    <th>Size</th>
                    <th>Color</th>
                    <th>Sale Price</th>
                    <th>Quantity</th>
                    <th>Images</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var variant in Model)
                {
                    <tr>
                        <td class="text-center">@variant.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(variant.CoverImageName))
                            {
                                <img src="~/images/products/@variant.CoverImageName"
                                     style="width:70px; height:70px; object-fit:cover; border-radius:8px; border:2px solid #e0e0e0;"
                                     alt="Cover" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center"
                                     style="width:70px; height:70px; border-radius:8px;">
                                    <i class="icon-image text-muted"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge bg-info" style="font-size: 13px;">
                                @(string.IsNullOrEmpty(variant.Size) ? "One Size" : variant.Size)
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(variant.ColorHexCode))
                                {
                                    <div style="width:24px; height:24px; background:@variant.ColorHexCode; border-radius:50%; border:2px solid #ddd;"></div>
                                }
                                <span style="font-weight: 500;">@variant.ColorName</span>
                            </div>
                        </td>
                        <td>
                            @if (variant.SalePrice.HasValue && variant.SalePrice.Value < variant.Price)
                            {
                                <!-- Endirimli qiymət -->
                                <div class="d-flex flex-column">
                                    <span class="text-danger fw-bold" style="font-size: 16px;">$@variant.SalePrice.Value.ToString("F2")</span>
                                    <span class="text-decoration-line-through text-muted small">$@variant.Price.ToString("F2")</span>
                                    @{
                                        var discount = (int)Math.Round((1 - (variant.SalePrice.Value / variant.Price)) * 100);
                                    }
                                    <span class="badge bg-danger mt-1" style="font-size: 11px; width: fit-content;">-@discount%</span>
                                </div>
                            }
                            else
                            {
                                <!-- Normal qiymət -->
                                <span class="fw-bold" style="font-size: 16px;">$@variant.Price.ToString("F2")</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(variant.Quantity > 0 ? "bg-success" : "bg-danger")" style="font-size: 13px;">
                                @variant.Quantity @(variant.Quantity == 1 ? "unit" : "units")
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-primary" style="font-size: 13px;">
                                <i class="icon-image me-1"></i>@variant.ImageNames.Count
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-primary"
                                        onclick="editVariant(@variant.Id)"
                                        title="Edit variant">
                                    <i class="icon-edit"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        onclick="deleteVariant(@variant.Id)"
                                        title="Delete variant">
                                    <i class="icon-trash-2"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="icon-info me-2"></i>
        No variants found for this product. Click "Add Variant" to create one.
    </div>
}