@using EcommerceCoza.BLL.ViewModels
@using static EcommerceCoza.BLL.ViewModels.ProductViewModel
@model ProductUpdateViewModel

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content">
    <div class="main-content-inner">
        <div class="main-content-wrap">
            <div class="flex items-center flex-wrap justify-between gap20 mb-27">
                <h3 style="font-size: 28px;">Edit Product</h3>
                <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
                    <li>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <div class="text-tiny" style="font-size: 14px;">Dashboard</div>
                        </a>
                    </li>
                    <li><i class="icon-chevron-right"></i></li>
                    <li>
                        <a asp-area="Admin" asp-controller="Product" asp-action="Index">
                            <div class="text-tiny" style="font-size: 14px;">Products</div>
                        </a>
                    </li>
                    <li><i class="icon-chevron-right"></i></li>
                    <li><div class="text-tiny" style="font-size: 14px;">Edit</div></li>
                </ul>
            </div>

            <!-- Product Basic Info -->
            <div class="wg-box mb-4">
                <h4 class="mb-4" style="font-size: 20px; font-weight: 600; border-bottom: 2px solid #e0e0e0; padding-bottom: 10px;">
                    <i class="icon-box me-2"></i>Basic Information
                </h4>
                <form asp-area="Admin"
                      asp-controller="Product"
                      asp-action="Edit"
                      method="post"
                      id="productForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label" style="font-size: 18px; font-weight: 600;">
                            Product Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name"
                               class="form-control"
                               style="font-size: 16px; padding: 12px;" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size: 14px;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label" style="font-size: 18px; font-weight: 600;">
                            Description <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control summernote"
                                  id="Description"></textarea>
                        <span asp-validation-for="Description" class="text-danger" style="font-size: 14px;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AdditionalInformation" class="form-label" style="font-size: 18px; font-weight: 600;">
                            Additional Information
                        </label>
                        <textarea asp-for="AdditionalInformation"
                                  class="form-control summernote"
                                  id="AdditionalInformation"></textarea>
                        <span asp-validation-for="AdditionalInformation" class="text-danger" style="font-size: 14px;"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <label asp-for="BasePrice" class="form-label" style="font-size: 18px; font-weight: 600;">
                                Base Price ($) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="BasePrice"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   style="font-size: 16px; padding: 12px;" />
                            <span asp-validation-for="BasePrice" class="text-danger" style="font-size: 14px;"></span>
                        </div>

                        <div class="col-md-4 mb-4">
                            <label asp-for="CategoryId" class="form-label" style="font-size: 18px; font-weight: 600;">
                                Category <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoryId"
                                    asp-items="Model.CategorySelectListItems"
                                    class="form-select"
                                    style="font-size: 16px; padding: 12px;">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger" style="font-size: 14px;"></span>
                        </div>

                        <div class="col-md-4 mb-4">
                            <label asp-for="BrandId" class="form-label" style="font-size: 18px; font-weight: 600;">
                                Brand <span class="text-danger">*</span>
                            </label>
                            <select asp-for="BrandId"
                                    asp-items="Model.BrandSelectListItems"
                                    class="form-select"
                                    style="font-size: 16px; padding: 12px;">
                                <option value="">-- Select Brand --</option>
                            </select>
                            <span asp-validation-for="BrandId" class="text-danger" style="font-size: 14px;"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-lg btn-primary" style="font-size: 18px; padding: 12px 30px;">
                            <i class="icon-save me-2"></i>Save Product
                        </button>
                        <a asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Index"
                           class="btn btn-lg btn-secondary" style="font-size: 18px; padding: 12px 30px;">
                            <i class="icon-x me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>

            <!-- Product Variants Section -->
            <div class="wg-box">
                <div class="d-flex justify-content-between align-items-center mb-4" style="border-bottom: 2px solid #e0e0e0; padding-bottom: 10px;">
                    <h4 style="font-size: 20px; font-weight: 600;">
                        <i class="icon-layers me-2"></i>Product Variants
                    </h4>
                    <div>
                        <button type="button" class="btn btn-lg btn-info me-2" onclick="openBulkAddModal()" style="font-size: 16px;">
                            <i class="icon-grid me-2"></i>Bulk Add
                        </button>
                        <button type="button" class="btn btn-lg btn-success" data-bs-toggle="modal" data-bs-target="#addVariantModal" style="font-size: 16px;">
                            <i class="icon-plus me-2"></i>Add Variant
                        </button>
                    </div>
                </div>

                <div id="variantsList">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Add Modal -->
<div class="modal fade" id="bulkAddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="font-size: 20px; font-weight: 600;">
                    <i class="icon-grid me-2"></i>Bulk Add Variants
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <label class="form-label" style="font-size: 16px; font-weight: 600;">Sizes <span class="text-danger">*</span></label>
                    <div class="input-group mb-2">
                        <input type="text" id="bulkSizeInput" class="form-control" placeholder="Enter size (e.g., S, M, L)" />
                        <button type="button" class="btn btn-primary" onclick="addBulkSize()">Add Size</button>
                    </div>
                    <div id="selectedSizes" class="d-flex gap-2 flex-wrap"></div>
                </div>

                <div class="mb-4">
                    <label class="form-label" style="font-size: 16px; font-weight: 600;">Colors <span class="text-danger">*</span></label>
                    <select id="bulkColorSelect" class="form-select mb-2">
                        <option value="">-- Select Color to Add --</option>
                    </select>
                    <div id="selectedColors" class="d-flex gap-2 flex-wrap"></div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label" style="font-size: 16px; font-weight: 600;">Regular Price ($) <span class="text-danger">*</span></label>
                        <input type="number" id="bulkPrice" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label" style="font-size: 16px; font-weight: 600;">Sale Price ($)</label>
                        <input type="number" id="bulkSalePrice" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label" style="font-size: 16px; font-weight: 600;">Quantity <span class="text-danger">*</span></label>
                        <input type="number" id="bulkQuantity" min="0" class="form-control" placeholder="0" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-size: 16px; font-weight: 600;">Cover Image <span class="text-danger">*</span></label>
                    <input type="file" id="bulkCoverImage" accept="image/*" class="form-control" onchange="previewBulkCoverImage(this)" />
                    <div id="bulkCoverImagePreview" class="mt-3" style="display:none;">
                        <img id="bulkCoverPreviewImg" src="#" style="width:200px; height:200px; object-fit:cover; border-radius:12px; border: 3px solid #e0e0e0;" alt="Cover Preview">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-size: 16px; font-weight: 600;">Additional Images</label>
                    <input type="file" id="bulkAdditionalImages" accept="image/*" multiple class="form-control" onchange="previewBulkAdditionalImages(this)" />
                    <div id="bulkAdditionalImagesPreview" class="mt-3 d-flex gap-3 flex-wrap"></div>
                </div>

                <div class="alert alert-warning">
                    <strong>Note:</strong> This will create variants for all combinations of selected sizes and colors.
                    <div id="combinationCount" class="mt-2">Select sizes and colors to see total combinations.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="createBulkBtn" class="btn btn-success" onclick="createBulkVariants()">Create Variants</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Variant Modal -->
<div class="modal fade" id="addVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="font-size: 20px; font-weight: 600;">Add New Variant</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addVariantForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="ProductId" value="@Model.Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="font-size: 16px; font-weight: 600;">Size</label>
                            <input type="text" name="Size" class="form-control" placeholder="e.g., S, M, L, XL" style="font-size: 16px; padding: 10px;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="font-size: 16px; font-weight: 600;">Color <span class="text-danger">*</span></label>
                            <select name="ColorId" class="form-select" required style="font-size: 16px; padding: 10px;">
                                <option value="">-- Select Color --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label" style="font-size: 16px; font-weight: 600;">Regular Price ($) <span class="text-danger">*</span></label>
                            <input type="number" name="Price" step="0.01" min="0" class="form-control" required style="font-size: 16px; padding: 10px;" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" style="font-size: 16px; font-weight: 600;">Sale Price ($)</label>
                            <input type="number" name="SalePrice" step="0.01" min="0" class="form-control" style="font-size: 16px; padding: 10px;" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" style="font-size: 16px; font-weight: 600;">Quantity <span class="text-danger">*</span></label>
                            <input type="number" name="Quantity" min="0" class="form-control" required style="font-size: 16px; padding: 10px;" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-size: 16px; font-weight: 600;">Cover Image <span class="text-danger">*</span></label>
                        <input type="file" name="CoverImageFile" accept="image/*" class="form-control" required style="font-size: 16px; padding: 10px;" onchange="previewCoverImage(this)" />
                        <div id="coverImagePreview" class="mt-2" style="display:none;">
                            <img id="coverPreviewImg" src="#" style="width:150px; height:150px; object-fit:cover; border-radius:8px;" alt="Cover Preview">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-size: 16px; font-weight: 600;">Additional Images</label>
                        <input type="file" name="ImageFiles" accept="image/*" multiple class="form-control" style="font-size: 16px; padding: 10px;" onchange="previewAdditionalImages(this)" />
                        <div id="additionalImagesPreview" class="mt-2 d-flex gap-2 flex-wrap"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="font-size: 16px;">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="font-size: 16px;">
                        <i class="icon-save me-2"></i>Save Variant
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Variant Modal -->
<div class="modal fade" id="editVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="font-size: 20px; font-weight: 600;">Edit Variant</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editVariantForm" enctype="multipart/form-data">
                <div class="modal-body" id="editVariantContent">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="font-size: 16px;">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="font-size: 16px;">
                        <i class="icon-save me-2"></i>Update Variant
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const productId = @Model.Id;
        let colors = [];
        let selectedBulkSizes = [];
        let selectedBulkColors = [];
        const addVariantForm = $('#addVariantForm');

        $(document).ready(function () {
            // Initialize Summernote for Description
            $('#Description').summernote({
                height: 200,
                placeholder: 'Enter product description...',
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
                    ['fontname', ['fontname']],
                    ['fontsize', ['fontsize']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ]
            });

            // Initialize Summernote for Additional Information
            $('#AdditionalInformation').summernote({
                height: 150,
                placeholder: 'Enter additional information...',
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link']],
                    ['view', ['fullscreen', 'codeview']]
                ]
            });

            loadVariants();
            loadColors();
        });

        function loadVariants() {
            $.get('@Url.Action("GetVariants", "Product", new { area = "Admin" })',
                { productId: productId },
                function (data) {
                    $('#variantsList').html(data);
                }).fail(function () {
                    $('#variantsList').html('<div class="alert alert-danger">Failed to load variants</div>');
                });
        }

        function loadColors() {
            $.get('@Url.Action("GetColors", "Product", new { area = "Admin" })',
                function (data) {
                    colors = data;
                    let colorSelect = addVariantForm.find('select[name="ColorId"]');
                    colorSelect.empty();
                    colorSelect.append('<option value="">-- Select Color --</option>');

                    let bulkColorSelect = $('#bulkColorSelect');
                    bulkColorSelect.empty();
                    bulkColorSelect.append('<option value="">-- Select Color to Add --</option>');

                    data.forEach(function (color) {
                        colorSelect.append(`<option value="${color.id}" data-name="${color.name}" data-hex="${color.hexCode || ''}">${color.name}</option>`);
                        bulkColorSelect.append(`<option value="${color.id}" data-name="${color.name}" data-hex="${color.hexCode || ''}">${color.name}</option>`);
                    });
                }).fail(function () {
                    showAlert('danger', 'Failed to load colors');
                });
        }

        // ADD VARIANT (single)
        addVariantForm.on('submit', function (e) {
            e.preventDefault();
            let formData = new FormData(this);

            $.ajax({
                url: '@Url.Action("CreateVariant", "Product", new { area = "Admin" })',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        $('#addVariantModal').modal('hide');
                        addVariantForm[0].reset();
                        $('#coverImagePreview').hide();
                        $('#additionalImagesPreview').empty();
                        loadVariants();
                        showAlert('success', response.message || 'Variant added successfully!');
                    } else {
                        showAlert('danger', response.message || 'Failed to add variant');
                    }
                },
                error: function () {
                    showAlert('danger', 'An error occurred while adding variant');
                }
            });
        });

        // EDIT VARIANT
        function editVariant(variantId) {
            $.get('@Url.Action("GetVariantForEdit", "Product", new { area = "Admin" })',
                { id: variantId },
                function (html) {
                    $('#editVariantContent').html(html);
                    $('#editVariantModal').modal('show');
                }).fail(function (xhr) {
                    showAlert('danger', 'Failed to load variant: ' + xhr.responseText);
                });
        }

        $('#editVariantForm').on('submit', function (e) {
            e.preventDefault();
            let formData = new FormData(this);

            $.ajax({
                url: '@Url.Action("UpdateVariant", "Product", new { area = "Admin" })',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        $('#editVariantModal').modal('hide');
                        loadVariants();
                        showAlert('success', response.message || 'Variant updated successfully!');
                    } else {
                        showAlert('danger', response.message || 'Failed to update variant');
                    }
                },
                error: function () {
                    showAlert('danger', 'An error occurred while updating variant');
                }
            });
        });

        function deleteVariant(variantId, size, color) {
            if (!confirm(`Are you sure you want to delete variant: ${size || ''} - ${color || ''}?`)) {
                return;
            }

            $.ajax({
                url: '@Url.Action("DeleteVariant", "Product", new { area = "Admin" })',
                type: 'POST',
                data: { id: variantId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        loadVariants();
                        showAlert('success', response.message || 'Variant deleted successfully!');
                    } else {
                        showAlert('danger', response.message || 'Failed to delete variant');
                    }
                },
                error: function () {
                    showAlert('danger', 'An error occurred while deleting variant');
                }
            });
        }

        // ========== BULK ADD LOGIC ==========
        function openBulkAddModal() {
            resetBulkForm();
            $('#bulkAddModal').modal('show');
        }

        function resetBulkForm() {
            selectedBulkSizes = [];
            selectedBulkColors = [];
            $('#bulkSizeInput').val('');
            $('#bulkPrice').val('');
            $('#bulkSalePrice').val('');
            $('#bulkQuantity').val('');
            $('#bulkCoverImage').val('');
            $('#bulkAdditionalImages').val('');
            $('#selectedSizes').empty();
            $('#selectedColors').empty();
            $('#bulkCoverImagePreview').hide();
            $('#bulkAdditionalImagesPreview').empty();
            updateCombinationCount();
        }

        function addBulkSize() {
            const val = $('#bulkSizeInput').val().trim();
            if (!val) { alert('Please enter a size'); return; }
            if (selectedBulkSizes.includes(val)) { alert('Size already added'); return; }
            selectedBulkSizes.push(val);
            renderSelectedSizes();
            $('#bulkSizeInput').val('');
            updateCombinationCount();
        }

        function renderSelectedSizes() {
            const c = $('#selectedSizes'); c.empty();
            selectedBulkSizes.forEach(s => {
                c.append(`<span class="badge bg-info d-flex align-items-center" style="padding:8px 12px;">${s} <button type="button" class="btn-close btn-close-white ms-2" style="font-size:10px;" onclick="removeBulkSize('${s}')"></button></span>`);
            });
        }

        function removeBulkSize(s) {
            selectedBulkSizes = selectedBulkSizes.filter(x => x !== s);
            renderSelectedSizes();
            updateCombinationCount();
        }

        $('#bulkColorSelect').on('change', function () {
            const sel = $(this).find(':selected');
            const id = $(this).val();
            if (!id) return;
            if (selectedBulkColors.some(c => c.id == id)) { alert('Color already added'); $(this).val(''); return; }
            selectedBulkColors.push({ id: id, name: sel.data('name'), hex: sel.data('hex') });
            renderSelectedColors();
            $(this).val('');
            updateCombinationCount();
        });

        function renderSelectedColors() {
            const c = $('#selectedColors'); c.empty();
            selectedBulkColors.forEach(col => {
                c.append(`<span class="badge bg-primary d-flex align-items-center" style="padding:8px 12px;">${col.hex ? `<span style="display:inline-block;width:16px;height:16px;background:${col.hex};border-radius:50%;margin-right:6px;border:1px solid #fff;"></span>` : ''}${col.name}<button type="button" class="btn-close btn-close-white ms-2" style="font-size:10px;" onclick="removeBulkColor(${col.id})"></button></span>`);
            });
        }

        function removeBulkColor(id) {
            selectedBulkColors = selectedBulkColors.filter(c => c.id != id);
            renderSelectedColors();
            updateCombinationCount();
        }

        function updateCombinationCount() {
            const count = selectedBulkSizes.length * selectedBulkColors.length;
            $('#combinationCount').html(count > 0 ? `<strong>Total combinations: ${count} variants will be created</strong>` : 'Select sizes and colors to see total combinations.');
        }

        function previewBulkCoverImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#bulkCoverPreviewImg').attr('src', e.target.result);
                    $('#bulkCoverImagePreview').show();
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewBulkAdditionalImages(input) {
            $('#bulkAdditionalImagesPreview').empty();
            if (input.files) {
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $('#bulkAdditionalImagesPreview').append(`<img src="${e.target.result}" style="width:100px;height:100px;object-fit:cover;border-radius:8px;border:2px solid #e0e0e0;" />`);
                    };
                    reader.readAsDataURL(file);
                });
            }
        }

        async function createBulkVariants() {
            if (selectedBulkSizes.length === 0) { alert('Add at least one size'); return; }
            if (selectedBulkColors.length === 0) { alert('Add at least one color'); return; }

            const price = $('#bulkPrice').val();
            const quantity = $('#bulkQuantity').val();
            const coverFile = $('#bulkCoverImage')[0].files[0];

            if (!price || !quantity || !coverFile) { alert('Fill price, quantity and cover image'); return; }

            const salePrice = $('#bulkSalePrice').val();
            const additionalFiles = Array.from($('#bulkAdditionalImages')[0].files || []);

            const combos = [];
            selectedBulkSizes.forEach(s => selectedBulkColors.forEach(c => combos.push({ size: s, color: c })));
            const total = combos.length;
            if (total === 0) return;

            const createBtn = $('#createBulkBtn');
            createBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Creating...');

            const ajaxCalls = combos.map(combo => {
                const fd = new FormData();
                fd.append('ProductId', productId);
                fd.append('Size', combo.size);
                fd.append('ColorId', combo.color.id);
                fd.append('Price', price);
                if (salePrice) fd.append('SalePrice', salePrice);
                fd.append('Quantity', quantity);
                fd.append('CoverImageFile', coverFile);
                additionalFiles.forEach(f => fd.append('ImageFiles', f));

                return $.ajax({
                    url: '@Url.Action("CreateVariant", "Product", new { area = "Admin" })',
                    type: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
                });
            });

            try {
                await Promise.all(ajaxCalls);
                $('#bulkAddModal').modal('hide');
                resetBulkForm();
                loadVariants();
                showAlert('success', `${total} variants created successfully`);
            } catch (err) {
                showAlert('danger', 'Some variants failed to create. Check console for details.');
                console.error(err);
                loadVariants();
            } finally {
                createBtn.prop('disabled', false).text('Create Variants');
            }
        }

        function previewCoverImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#coverPreviewImg').attr('src', e.target.result);
                    $('#coverImagePreview').show();
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewAdditionalImages(input) {
            $('#additionalImagesPreview').empty();
            if (input.files) {
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $('#additionalImagesPreview').append(`<img src="${e.target.result}" style="width:100px;height:100px;object-fit:cover;border-radius:8px;border:2px solid #e0e0e0;" />`);
                    };
                    reader.readAsDataURL(file);
                });
            }
        }

        function showAlert(type, message) {
            let alertHtml = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
            $('.main-content-wrap').prepend(alertHtml);
            setTimeout(() => $('.alert').fadeOut(), 5000);
        }
    </script>

    <style>
        .btn-close-white {
            filter: brightness(0) invert(1);
        }

        .modal-xl {
            max-width: 1000px;
        }

        .note-editor {
            border: 1px solid #ddd !important;
            border-radius: 8px !important;
        }

            .note-editor .note-toolbar {
                background-color: #f8f9fa !important;
            }

            .note-editor .note-editable {
                padding: 15px !important;
            }
    </style>
}