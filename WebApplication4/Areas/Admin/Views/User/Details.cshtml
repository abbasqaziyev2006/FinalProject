@model EcommerceCoza.BLL.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "User Details";
}

<div class="main-content">
    <div class="main-content-inner">
        <div class="main-content-wrap">
            <h3>User Details</h3>

            <div class="wg-box p-4">
                @if (Model == null)
                {
                    <div class="alert alert-warning">User not found.</div>
                }
                else
                {
                    <dl class="row">
                        <dt class="col-sm-3">Username</dt>
                        <dd class="col-sm-9">@Html.Encode(Model.UserName ?? "—")</dd>

                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">
                            @{
                                var fullName = string.Join(" ", new[] { Model.FirstName, Model.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                if (string.IsNullOrWhiteSpace(fullName))
                                {
                                    fullName = Model.UserName ?? "—";
                                }
                            }
                            @Html.Encode(fullName)
                        </dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <a href="mailto:@Model.Email">@Html.Encode(Model.Email)</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Phone</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                            {
                                <a href="tel:@Model.PhoneNumber">@Html.Encode(Model.PhoneNumber)</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Email Verified</dt>
                        <dd class="col-sm-9">
                            @if (Model.EmailConfirmed)
                            {
                                <span class="badge badge-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">No</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Roles</dt>
                        <dd class="col-sm-9">
                            @{
                                var roles = (Model.SelectedRoles ?? new List<string>()).Where(r => !string.IsNullOrWhiteSpace(r)).ToList();
                                if (roles.Any())
                                {
                                    foreach (var r in roles)
                                    {
                                        <span class="badge badge-info mr-1">@Html.Encode(r)</span>
                                    }
                                }
                                else
                                {
                                    <span>None</span>
                                }
                            }
                        </dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>

                        <form asp-area="Admin" asp-controller="User" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>

                        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-secondary">Back to list</a>
                    </div>
                }
            </div>

        </div>
    </div>
</div>