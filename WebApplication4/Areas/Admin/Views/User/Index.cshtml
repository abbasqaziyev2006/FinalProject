@model EcommerceCoza.BLL.ViewModels.UserListViewModel

<div class="main-content">

    <div class="main-content-inner">
        <div class="main-content-wrap">
            <div class="flex items-center flex-wrap justify-between gap20 mb-27">
                <h3>Users</h3>
                <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
                    <li>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <div class="text-tiny">Dashboard</div>
                        </a>
                    </li>
                    <li>
                        <i class="icon-chevron-right"></i>
                    </li>
                    <li>
                        <div class="text-tiny">All User</div>
                    </li>
                </ul>
            </div>

            <div class="wg-box">
                <div class="flex items-center justify-between gap10 flex-wrap">
                    <div class="wg-filter flex-grow">
                        <form class="form-search" method="get">
                            <fieldset class="name">
                                <input type="text" placeholder="Search here..." class="" name="searchTerm"
                                       tabindex="2" value="@Model.SearchTerm" aria-required="true">
                            </fieldset>
                            <div class="button-submit">
                                <button class="" type="submit"><i class="icon-search"></i></button>
                            </div>
                        </form>
                    </div>

                </div>
                <div class="wg-table table-all-user">

                    <div class="table-responsive">
                        @if (Model.Users != null && Model.Users.Any())
                        {
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>User</th>
                                        <th>Phone</th>
                                        <th>Email</th>
                                        <th class="text-center">Total Orders</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int index = 1;
                                    }
                                    @foreach (var user in Model.Users)
                                    {
                                        <tr>
                                            <td>@index</td>
                                            <td class="pname">
                                                <div class="name">
                                                    <a href="#" class="body-title-2">@user.FirstName @user.LastName</a>
                                                    <div class="text-tiny mt-3">@user.UserName</div>
                                                </div>
                                            </td>
                                            <td>@(user.PhoneNumber ?? "N/A")</td>
                                            <td>@user.Email</td>
                                            <td class="text-center">
                                                <a asp-area="" asp-controller="Order" asp-action="Index" target="_blank">@user.TotalOrders</a>
                                            </td>
                                            <td>
                                                <div class="list-icon-function">
                                                    <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@user.Id" title="Edit">
                                                        <div class="item edit">
                                                            <i class="icon-edit-3"></i>
                                                        </div>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-center">No users found.</p>
                        }
                    </div>

                </div>
                <div class="divider"></div>
                <div class="flex items-center justify-between flex-wrap gap10 wgp-pagination">
                </div>
            </div>
        </div>
    </div>

    <div class="bottom-page">
        <div class="body-text">Copyright © 2024 SurfsideMedia</div>
    </div>
</div>