@using EcommerceCoza.BLL.ViewModels
@model BrandUpdateViewModel

@{
    ViewData["Title"] = "Edit Brand";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content">
    <div class="main-content-inner">
        <div class="main-content-wrap">
            <div class="flex items-center flex-wrap justify-between gap20 mb-27">
                <h3 style="font-size: 28px;">Edit Brand</h3>
                <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
                    <li>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <div class="text-tiny" style="font-size: 14px;">Dashboard</div>
                        </a>
                    </li>
                    <li><i class="icon-chevron-right"></i></li>
                    <li>
                        <a asp-area="Admin" asp-controller="Brand" asp-action="Index">
                            <div class="text-tiny" style="font-size: 14px;">Brands</div>
                        </a>
                    </li>
                    <li><i class="icon-chevron-right"></i></li>
                    <li><div class="text-tiny" style="font-size: 14px;">Edit</div></li>
                </ul>
            </div>

            <div class="wg-box">
                <form asp-area="Admin"
                      asp-controller="Brand"
                      asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CurrentLogoUrl" />

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label" style="font-size: 18px; font-weight: 600;">
                            Brand Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" style="font-size: 16px; padding: 12px;" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size: 14px;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label" style="font-size: 18px; font-weight: 600;">
                            Description
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control summernote"
                                  id="Description"></textarea>
                        <span asp-validation-for="Description" class="text-danger" style="font-size: 14px;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="LogoFile" class="form-label" style="font-size: 18px; font-weight: 600;">Logo</label>
                        <div class="upload-image flex-grow">
                            <div class="item" id="imgpreview" style="@(string.IsNullOrEmpty(Model.CurrentLogoUrl) ? "display:none" : "")">
                                <img src="@Model.CurrentLogoUrl"
                                     id="preview-img"
                                     style="width:120px; height:120px; object-fit:cover; border-radius:8px; border: 2px solid #e0e0e0;"
                                     alt="@Model.Name">
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2 d-block" onclick="changeLogo()">
                                    <i class="icon-edit me-1"></i>Change Logo
                                </button>
                            </div>
                            <div id="upload-file" class="item up-load" style="@(string.IsNullOrEmpty(Model.CurrentLogoUrl) ? "" : "display:none")">
                                <label class="uploadfile" for="LogoFile" style="cursor: pointer;">
                                    <span class="icon">
                                        <i class="icon-upload-cloud" style="font-size: 32px;"></i>
                                    </span>
                                    <span class="body-text" style="font-size: 16px; margin-top: 10px; display: block;">
                                        Drop your image here or <span class="tf-color">click to browse</span>
                                    </span>
                                    <input asp-for="LogoFile"
                                           type="file"
                                           id="LogoFile"
                                           accept="image/*"
                                           style="display: none;"
                                           onchange="previewLogo(this)">
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="LogoFile" class="text-danger" style="font-size: 14px;"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check" style="padding-left: 0;">
                            <label style="font-size: 18px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 10px;">
                                <input type="checkbox"
                                       name="IsActive"
                                       value="true"
                                       @(Model.IsActive ? "checked" : "")
                                       style="width: 24px; height: 24px; cursor: pointer;" />
                                <span>Active</span>
                            </label>
                            <input type="hidden" name="IsActive" value="false" />
                        </div>
                        <small class="text-muted" style="font-size: 14px; display: block; margin-top: 8px; margin-left: 34px;">Check this to make the brand visible on the website</small>
                    </div>

                    <div class="d-flex gap-3 mt-5">
                        <button type="submit" class="btn btn-lg btn-primary" style="font-size: 18px; padding: 12px 30px;">
                            <i class="icon-save me-2"></i>Save Changes
                        </button>
                        <a asp-area="Admin"
                           asp-controller="Brand"
                           asp-action="Index"
                           class="btn btn-lg btn-secondary" style="font-size: 18px; padding: 12px 30px;">
                            <i class="icon-x me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            $('#Description').summernote({
                height: 150,
                placeholder: 'Enter brand description...',
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
                    ['fontsize', ['fontsize']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['insert', ['link']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ]
            });
        });

        function previewLogo(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#preview-img').attr('src', e.target.result);
                    $('#imgpreview').show();
                    $('#upload-file').hide();
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function changeLogo() {
            $('#LogoFile').click();
        }
    </script>

    <style>
        .upload-image {
            border: 2px dashed #ddd;
            border-radius: 8px;
            padding: 20px;
            transition: border-color 0.3s;
        }

            .upload-image:hover {
                border-color: #007bff;
            }

        .note-editor {
            border: 1px solid #ddd !important;
            border-radius: 8px !important;
        }

            .note-editor .note-toolbar {
                background-color: #f8f9fa !important;
            }

            .note-editor .note-editable {
                padding: 15px !important;
            }
    </style>
}