@model EcommerceCoza.BLL.ViewModels.BasketViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject WebApplication4.Services.ICurrencyService CurrencyService

<main class="main-cart-container" style="padding-top: 120px; padding-bottom: 60px; min-height: 100vh;">
    <div class="container" style="max-width: 1400px;">
        <div class="row">
            <div class="col-lg-8 mb-3">
                <div class="cart-card p-4 rounded shadow-sm">
                    <h2 class="h4 mb-4 title-text">@Localizer["Shopping Cart"]</h2>

                    @if (Model.Items.Any())
                    {
                        <div class="row border-bottom-theme pb-2 mb-3 d-none d-md-flex">
                            <div class="col text-end">
                                <small class="text-muted-theme">@Localizer["Price"]</small>
                            </div>
                        </div>

                        @foreach (var item in Model.Items)
                        {
                            <div class="cart-item border-bottom-theme py-3 mb-3" data-variant-id="@item.ProductVariantId">
                                <div class="row align-items-center">
                                    <div class="col-auto">
                                        <img src="~/images/products/@item.ImageName" alt="@item.ProductName" class="rounded product-img">
                                    </div>

                                    <div class="col">
                                        <h5 class="mb-2 fw-normal title-text">@item.ProductName</h5>
                                        <p class="text-muted-theme mb-3" style="font-size: 14px;">
                                            <strong>@Localizer["Color"]:</strong> @item.ColorName
                                            @if (!string.IsNullOrEmpty(item.Size))
                                            {
                                                <span class="ms-3"><strong>@Localizer["Size"]:</strong> @item.Size</span>
                                            }
                                        </p>

                                        <div class="d-flex align-items-center gap-0">
                                            <button type="button"
                                                    class="qty-btn qty-decrease"
                                                    data-variant-id="@item.ProductVariantId">
                                                −
                                            </button>

                                            <input type="number"
                                                   class="qty-input form-control text-center"
                                                   data-variant-id="@item.ProductVariantId"
                                                   value="@item.Quantity"
                                                   min="1"
                                                   oninput="this.value = !!this.value && Math.abs(this.value) >= 1 ? Math.abs(this.value) : 1">

                                            <button type="button"
                                                    class="qty-btn qty-increase"
                                                    data-variant-id="@item.ProductVariantId">
                                                +
                                            </button>

                                            <button type="button" class="btn-delete-text ms-3"
                                                    data-variant-id="@item.ProductVariantId"
                                                    data-product-name="@item.ProductName">
                                                @Localizer["Delete"]
                                            </button>
                                        </div>
                                    </div>

                                    <div class="col-auto text-end">
                                        <p class="fw-bold mb-0 item-price price-text" data-price="@item.TotalPrice">
                                            @Html.Raw(CurrencyService.Format(item.TotalPrice))
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="text-end mt-4 pt-3 border-top-theme">
                            <p class="mb-0">
                                <span class="text-muted-theme">@Localizer["Subtotal"] (<span id="cart-items-count-bottom">@Model.TotalCount</span> @Localizer["Items"]):</span>
                                <strong class="ms-3 price-text" style="font-size: 20px;" id="cart-subtotal-bottom" data-original-total="@Model.TotalPrice">
                                    @Html.Raw(CurrencyService.Format(Model.TotalPrice))
                                </strong>
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <h5 class="title-text mb-3">@Localizer["Your Basket Is Empty"]</h5>
                            <a asp-controller="Shop" asp-action="Index" class="btn btn-warning px-4">@Localizer["Continue Shopping"]</a>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                @if (Model.Items.Any())
                {
                    <div class="cart-card p-4 rounded shadow-sm">
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-checkout w-100 rounded-pill py-3 mb-4 text-uppercase fw-bold">
                            @Localizer["Proceed To Checkout"]
                        </a>

                        <div class="mb-3">
                            <p class="mb-2 text-muted-theme" style="font-size: 14px;">@Localizer["Subtotal"] (<span id="cart-items-count">@Model.TotalCount</span> @Localizer["Items"]):</p>
                            <p class="mb-0">
                                <strong class="price-text" style="font-size: 24px;" id="cart-subtotal" data-original-total="@Model.TotalPrice">
                                    @Html.Raw(CurrencyService.Format(Model.TotalPrice))
                                </strong>
                            </p>
                        </div>

                        <div id="discount-info" class="alert alert-success d-none mb-3 discount-alert">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong id="discount-code"></strong>
                                    <div class="small">@Localizer["Discount"]: <span id="discount-percentage"></span>%</div>
                                    <div class="small">-<span id="discount-amount"></span></div>
                                </div>
                                <button type="button" class="btn-close btn-close-theme" id="remove-coupon"></button>
                            </div>
                        </div>

                        <hr class="border-theme">
                        <div class="mt-3">
                            <a href="#" class="coupon-link text-decoration-none" data-bs-toggle="collapse" data-bs-target="#couponCollapse">
                                <i class="bi bi-tag-fill me-2"></i>@Localizer["Enter Coupon Code"]
                            </a>
                            <div class="collapse mt-3" id="couponCollapse">
                                <form id="coupon-form" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="text" id="coupon-code-input" name="couponCode" class="form-control coupon-input" placeholder="@Localizer["Enter Code"]">
                                    <button type="submit" class="btn btn-outline-warning">@Localizer["Apply"]</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-theme">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title title-text">@Localizer["Confirm Deletion"]</h5>
                <button type="button" class="btn-close btn-close-theme" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="title-text">@Localizer["Are You Sure To Remove"]</p>
                <p class="text-warning mb-0" id="productNameToDelete"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">@Localizer["Delete"]</button>
            </div>
        </div>
    </div>
</div>

<style>

    .main-cart-container {
        background-color: #f8f9fa;
        color: #212529;
    }

    .cart-card {
        background-color: #ffffff;
        border: 1px solid #dee2e6;
    }

    .title-text {
        color: #212529;
    }

    .text-muted-theme {
        color: #6c757d;
    }

    .price-text {
        color: #212529;
    }

    .border-bottom-theme {
        border-bottom: 1px solid #dee2e6;
    }

    .border-top-theme {
        border-top: 1px solid #dee2e6;
    }

    .border-theme {
        border-color: #dee2e6 !important;
    }

    .product-img {
        width: 120px;
        height: 150px;
        object-fit: cover;
        border: 1px solid #dee2e6;
    }

    .qty-btn {
        width: 38px;
        height: 38px;
        background-color: #e9ecef;
        color: #212529;
        border: 1px solid #ced4da;
        font-size: 18px;
        transition: 0.2s;
    }

        .qty-btn:hover {
            background-color: #dee2e6;
        }

    .qty-input {
        width: 60px;
        height: 38px;
        background-color: #ffffff;
        color: #212529;
        border: 1px solid #ced4da;
        border-radius: 0;
        font-weight: bold;
    }

        .qty-input::-webkit-outer-spin-button,
        .qty-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    .btn-delete-text {
        background: none;
        border: none;
        color: #6c757d;
        font-size: 14px;
        padding: 0;
    }

        .btn-delete-text:hover {
            color: #dc3545;
            text-decoration: underline;
        }

    .btn-checkout {
        background: #ffd814;
        color: #000;
    }

        .btn-checkout:hover {
            background: #f7ca00;
            color: #000;
        }

    .modal-content-theme {
        background-color: #ffffff;
        color: #212529;
        border: 1px solid #dee2e6;
    }

    .btn-close-theme {
        filter: none;
    }

    .coupon-input {
        background-color: #ffffff;
        color: #212529;
        border: 1px solid #ced4da;
    }

    .discount-alert {
        background-color: #d1e7dd !important;
        border-color: #badbcc !important;
        color: #0f5132 !important;
    }

    .coupon-link {
        color: #212529;
        font-size: 15px;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-block;
    }

        .coupon-link:hover {
            color: #000000;
            transform: translateX(3px);
        }

        .coupon-link i {
            font-size: 16px;
        }

    /* Dark Mode */
    [data-bs-theme="dark"] .main-cart-container {
        background-color: #121212;
        color: #e0e0e0;
    }

    [data-bs-theme="dark"] .cart-card {
        background-color: #1e1e1e;
        border: 1px solid #333;
    }

    [data-bs-theme="dark"] .title-text {
        color: #ffffff;
    }

    [data-bs-theme="dark"] .text-muted-theme {
        color: #b0b0b0;
    }

    [data-bs-theme="dark"] .price-text {
        color: #ffffff;
    }

    [data-bs-theme="dark"] .border-bottom-theme {
        border-bottom: 1px solid #333;
    }

    [data-bs-theme="dark"] .border-top-theme {
        border-top: 1px solid #333;
    }

    [data-bs-theme="dark"] .border-theme {
        border-color: #333 !important;
    }

    [data-bs-theme="dark"] .product-img {
        border: 1px solid #333;
    }

    [data-bs-theme="dark"] .qty-btn {
        background-color: #333;
        color: #fff;
        border: 1px solid #444;
    }

        [data-bs-theme="dark"] .qty-btn:hover {
            background-color: #444;
        }

    [data-bs-theme="dark"] .qty-input {
        background-color: #1e1e1e;
        color: #fff;
        border: 1px solid #444;
    }

    [data-bs-theme="dark"] .btn-delete-text {
        color: #b0b0b0;
    }

        [data-bs-theme="dark"] .btn-delete-text:hover {
            color: #ff4d4d;
        }

    [data-bs-theme="dark"] .modal-content-theme {
        background-color: #1e1e1e;
        color: #ffffff;
        border: 1px solid #333;
    }

    [data-bs-theme="dark"] .btn-close-theme {
        filter: invert(1) grayscale(100%) brightness(200%);
    }

    [data-bs-theme="dark"] .coupon-input {
        background-color: #1e1e1e;
        color: #ffffff;
        border: 1px solid #444;
    }

    [data-bs-theme="dark"] .discount-alert {
        background-color: #1e3a28 !important;
        border-color: #28a745 !important;
        color: #7ed99e !important;
    }

    [data-bs-theme="dark"] .coupon-link {
        color: #ffffff;
    }

        [data-bs-theme="dark"] .coupon-link:hover {
            color: #f0f0f0;
        }


    @@keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    /* Explicit overrides to force fully black basket panel like About Us page */
    :root[data-theme="dark"] .main-cart-container,
    html.dark-mode .main-cart-container,
    body.dark-mode .main-cart-container,
    :root[data-theme="dark"] .cart-card,
    html.dark-mode .cart-card,
    body.dark-mode .cart-card {
        background-color: #0b0b0b !important; /* full black */
        color: #f5f5f5 !important;
        border-color: rgba(255,255,255,0.06) !important;
        box-shadow: none !important;
    }

        /* Make cart-items blend into the card (prevent half-white areas) */
        :root[data-theme="dark"] .cart-card .cart-item,
        html.dark-mode .cart-card .cart-item,
        body.dark-mode .cart-card .cart-item {
            background-color: transparent !important;
            color: inherit !important;
            border-color: rgba(255,255,255,0.04) !important;
        }

        /* Ensure internal controls are visible on pure black */
        :root[data-theme="dark"] .cart-card .title-text,
        :root[data-theme="dark"] .cart-card .price-text,
        :root[data-theme="dark"] .cart-card .text-muted-theme,
        body.dark-mode .cart-card .title-text,
        body.dark-mode .cart-card .price-text,
        body.dark-mode .cart-card .text-muted-theme {
            color: #f5f5f5 !important;
        }

        :root[data-theme="dark"] .cart-card .qty-btn,
        body.dark-mode .cart-card .qty-btn {
            background-color: #151515 !important;
            border-color: rgba(255,255,255,0.06) !important;
            color: #fff !important;
        }

        :root[data-theme="dark"] .cart-card .qty-input,
        body.dark-mode .cart-card .qty-input {
            background-color: #171717 !important;
            color: #fff !important;
            border-color: rgba(255,255,255,0.06) !important;
        }

        :root[data-theme="dark"] .cart-card .product-img,
        body.dark-mode .cart-card .product-img {
            border-color: rgba(255,255,255,0.06) !important;
            background-color: transparent !important;
        }

    /* Sidebar card (checkout / coupon) */
    :root[data-theme="dark"] .col-lg-4 .cart-card,
    body.dark-mode .col-lg-4 .cart-card {
        background-color: #0b0b0b !important;
        color: #f5f5f5 !important;
        border-color: rgba(255,255,255,0.06) !important;
    }

    /* Remove any inline white backgrounds inside cart-card */
    :root[data-theme="dark"] .cart-card [style*="background:#fff"],
    body.dark-mode .cart-card [style*="background:#fff"],
    :root[data-theme="dark"] .cart-card [style*="background: #fff"],
    body.dark-mode .cart-card [style*="background: #fff"] {
        background-color: transparent !important;
    }

</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            let appliedCoupon = null;
            let variantIdToDelete = null;

            function formatCurrency(amount) {
                return new Intl.NumberFormat('az-AZ', {
                    style: 'currency', currency: 'AZN'
                }).format(amount);
            }


            $(document).on('change', '.qty-input', function() {
                const variantId = $(this).data('variant-id');
                const newQty = parseInt($(this).val());

                if (newQty < 1 || isNaN(newQty)) {
                    $(this).val(1);
                    return;
                }


                $.get('@Url.Action("GetBasket", "Basket")', data => {
                    const currentItem = data.items.find(x => x.productVariantId === variantId);
                    if(currentItem) {
                        const diff = newQty - currentItem.quantity;
                        if(diff !== 0) changeQuantity(variantId, diff);
                    }
                });
            });


            $(document).on('click', '.qty-increase', function () {
                changeQuantity($(this).data('variant-id'), 1);
            });

            $(document).on('click', '.qty-decrease', function () {
                const variantId = $(this).data('variant-id');
                const $input = $(`.qty-input[data-variant-id="${variantId}"]`);
                if (parseInt($input.val()) > 1) {
                    changeQuantity(variantId, -1);
                } else {
                    showDeleteConfirmation(variantId, $(this).closest('.cart-item').find('h5').text());
                }
            });

            function changeQuantity(variantId, change) {
                $.post('@Url.Action("ChangeQuantity", "Basket")', { productVariantId: variantId, change: change })
                .done(res => {
                    const item = res?.basketViewModel?.items?.find(x => x.productVariantId === variantId);
                    if (item) {
                        $(`.qty-input[data-variant-id="${variantId}"]`).val(item.quantity);
                        $(`.cart-item[data-variant-id="${variantId}"] .item-price`).html(formatCurrency(item.totalPrice));
                        updateTotals();
                    }
                });
            }


            $(document).on('click', '.btn-delete-text', function () {
                variantIdToDelete = $(this).data('variant-id');
                $('#productNameToDelete').text($(this).data('product-name'));
                $('#deleteConfirmModal').modal('show');
            });

            $('#confirmDeleteBtn').on('click', function () {
                $.post('@Url.Action("Remove", "Basket")', { id: variantIdToDelete }).done(() => location.reload());
            });


            function updateTotals() {
                $.get('@Url.Action("GetBasket", "Basket")', data => {
                    $('#cart-items-count, #cart-items-count-bottom').text(data.totalCount);
                    $('.header__cart-count').text(data.totalCount || 0);

                    if (appliedCoupon) {
                        const disc = (data.totalPrice * appliedCoupon.salePercentage) / 100;
                        const final = data.totalPrice - disc;
                        $('#discount-amount').html(formatCurrency(disc));
                        const html = `<span class="text-decoration-line-through text-muted-theme me-2">${formatCurrency(data.totalPrice)}</span>${formatCurrency(final)}`;
                        $('#cart-subtotal, #cart-subtotal-bottom').html(html);
                    } else {
                        $('#cart-subtotal, #cart-subtotal-bottom').html(formatCurrency(data.totalPrice));
                    }
                });
            }


            $('#coupon-form').on('submit', function (e) {
                e.preventDefault();
                const code = $('#coupon-code-input').val().trim();
                $.ajax({
                    url: '@Url.Action("ApplyDiscount", "Basket")',
                    type: 'POST',
                    data: { discountCode: code },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (res) {
                        if (res.success) {
                            appliedCoupon = { code: code, salePercentage: res.salePercentage };
                            $('#discount-info').removeClass('d-none');
                            $('#discount-code').text(code);
                            $('#discount-percentage').text(res.salePercentage);
                            updateTotals();
                            $('#couponCollapse').collapse('hide');
                        }
                    }
                });
            });

            $('#remove-coupon').on('click', function () {
                appliedCoupon = null;
                $('#discount-info').addClass('d-none');
                $.post('@Url.Action("RemoveDiscount", "Basket")', () => updateTotals());
            });
        });
    </script>
}