@model EcommerceCoza.BLL.ViewModels.BasketViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject WebApplication4.Services.ICurrencyService CurrencyService

<main class="main-cart-container" style="padding-top: 120px; padding-bottom: 60px; min-height: 100vh;">
    <div class="container" style="max-width: 1400px;">
        <div class="row">
            <div class="col-lg-8 mb-3">
                <div class="cart-card p-4 rounded shadow-sm">
                    <h2 class="h4 mb-4 title-text">@Localizer["Shopping Cart"]</h2>

                    @if (Model.Items.Any())
                    {
                        <div class="row border-bottom-theme pb-2 mb-3 d-none d-md-flex">
                            <div class="col text-end">
                                <small class="text-muted-theme">@Localizer["Price"]</small>
                            </div>
                        </div>

                        @foreach (var item in Model.Items)
                        {
                            <div class="cart-item border-bottom-theme py-3 mb-3" data-variant-id="@item.ProductVariantId">
                                <div class="row align-items-center">
                                    <div class="col-auto">
                                        <img src="~/images/products/@item.ImageName" alt="@item.ProductName" class="rounded product-img">
                                    </div>

                                    <div class="col">
                                        <h5 class="mb-2 fw-normal title-text">@item.ProductName</h5>
                                        <p class="text-muted-theme mb-3" style="font-size: 14px;">
                                            <strong>@Localizer["Color"]:</strong> @item.ColorName
                                            @if (!string.IsNullOrEmpty(item.Size))
                                            {
                                                <span class="ms-3"><strong>@Localizer["Size"]:</strong> @item.Size</span>
                                            }
                                        </p>

                                        <div class="d-flex align-items-center gap-0">
                                            <button type="button"
                                                    class="qty-btn qty-decrease"
                                                    data-variant-id="@item.ProductVariantId">
                                                −
                                            </button>

                                            <input type="number"
                                                   class="qty-input form-control text-center"
                                                   data-variant-id="@item.ProductVariantId"
                                                   value="@item.Quantity"
                                                   min="1"
                                                   oninput="this.value = !!this.value && Math.abs(this.value) >= 1 ? Math.abs(this.value) : 1">

                                            <button type="button"
                                                    class="qty-btn qty-increase"
                                                    data-variant-id="@item.ProductVariantId">
                                                +
                                            </button>

                                            <button type="button" class="btn-delete-text ms-3"
                                                    data-variant-id="@item.ProductVariantId"
                                                    data-product-name="@item.ProductName">
                                                @Localizer["Delete"]
                                            </button>
                                        </div>
                                    </div>

                                    <div class="col-auto text-end">
                                        <p class="fw-bold mb-0 item-price price-text" data-price="@item.TotalPrice">
                                            @Html.Raw(CurrencyService.Format(item.TotalPrice))
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="text-end mt-4 pt-3 border-top-theme">
                            <p class="mb-0">
                                <span class="text-muted-theme">@Localizer["Subtotal"] (<span id="cart-items-count-bottom">@Model.TotalCount</span> @Localizer["Items"]):</span>
                                <strong class="ms-3 price-text" style="font-size: 20px;" id="cart-subtotal-bottom" data-original-total="@Model.TotalPrice">
                                    @Html.Raw(CurrencyService.Format(Model.TotalPrice))
                                </strong>
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <h5 class="title-text mb-3">@Localizer["Your Basket Is Empty"]</h5>
                            <a asp-controller="Shop" asp-action="Index" class="btn btn-warning px-4">@Localizer["Continue Shopping"]</a>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                @if (Model.Items.Any())
                {
                    <div class="cart-card p-4 rounded shadow-sm">
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-checkout w-100 rounded-pill py-3 mb-4 text-uppercase fw-bold">
                            @Localizer["Proceed To Checkout"]
                        </a>

                        <div class="mb-3">
                            <p class="mb-2 text-muted-theme" style="font-size: 14px;">@Localizer["Subtotal"] (<span id="cart-items-count">@Model.TotalCount</span> @Localizer["Items"]):</p>
                            <p class="mb-0">
                                <strong class="price-text" style="font-size: 24px;" id="cart-subtotal" data-original-total="@Model.TotalPrice">
                                    @Html.Raw(CurrencyService.Format(Model.TotalPrice))
                                </strong>
                            </p>
                        </div>

                        <div id="discount-info" class="alert alert-success d-none mb-3 discount-alert">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong id="discount-code"></strong>
                                    <div class="small">@Localizer["Discount"]: <span id="discount-percentage"></span>%</div>
                                    <div class="small">-<span id="discount-amount"></span></div>
                                </div>
                                <button type="button" class="btn-close btn-close-theme" id="remove-coupon"></button>
                            </div>
                        </div>

                        <hr class="border-theme">
                        <div class="mt-3">
                            <a href="#" class="coupon-link text-decoration-none" data-bs-toggle="collapse" data-bs-target="#couponCollapse">
                                <i class="bi bi-tag-fill me-2"></i>@Localizer["Enter Coupon Code"]
                            </a>
                            <div class="collapse mt-3" id="couponCollapse">
                                <form id="coupon-form" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="text" id="coupon-code-input" name="couponCode" class="form-control coupon-input" placeholder="@Localizer["Enter Code"]">
                                    <button type="submit" class="btn btn-outline-warning">@Localizer["Apply"]</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-theme">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title title-text">@Localizer["Confirm Deletion"]</h5>
                <button type="button" class="btn-close btn-close-theme" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="title-text">@Localizer["Are You Sure To Remove"]</p>
                <p class="text-warning mb-0" id="productNameToDelete"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">@Localizer["Delete"]</button>
            </div>
        </div>
    </div>
</div>

<style>
    .main-cart-container {
        background-color: #f8f9fa;
        color: #212529;
    }

    .cart-card {
        background-color: #ffffff;
        border: 1px solid #dee2e6;
    }

    .title-text {
        color: #212529;
    }

    /* make muted text darker (more contrast) */
    .text-muted-theme {
        color: #535353 !important;
    }
    /* darker gray */

    /* price and general text */
    .price-text {
        color: #1f1f1f;
        font-weight: 700;
    }

    .border-bottom-theme {
        border-bottom: 1px solid #e6e6e6;
    }

    .border-top-theme {
        border-top: 1px solid #e6e6e6;
    }

    .border-theme {
        border-color: #e6e6e6 !important;
    }

    /* product image */
    .product-img {
        width: 120px;
        height: 150px;
        object-fit: cover;
        border: 1px solid #dee2e6;
        background: #fff;
    }

    /* qty controls — make darker greys for controls */
    .qty-btn {
        width: 38px;
        height: 38px;
        background-color: #f0f0f0;
        color: #2b2b2b;
        border: 1px solid #bfbfbf;
        font-size: 18px;
        transition: 0.15s;
    }

        .qty-btn:hover {
            background-color: #e1e1e1;
        }

    .qty-input {
        width: 60px;
        height: 38px;
        background-color: #ffffff;
        color: #2b2b2b;
        border: 1px solid #c6c6c6;
        border-radius: 0;
        font-weight: 700;
    }

        .qty-input::-webkit-outer-spin-button, .qty-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    /* delete text — darker gray and stronger hover */
    .btn-delete-text {
        background: none;
        border: none;
        color: #5b5b5b;
        font-size: 14px;
        padding: 0;
    }

        .btn-delete-text:hover {
            color: #b22222;
            text-decoration: underline;
        }

    .btn-checkout {
        background: #ffd814;
        color: #000;
    }

        .btn-checkout:hover {
            background: #f7ca00;
            color: #000;
        }

    .modal-content-theme {
        background-color: #ffffff;
        color: #212529;
        border: 1px solid #dee2e6;
    }

    .btn-close-theme {
        filter: none;
    }

    .coupon-input {
        background-color: #ffffff;
        color: #212529;
        border: 1px solid #ced4da;
    }

    .discount-alert {
        background-color: #dff0d8 !important;
        border-color: #c3e6cb !important;
        color: #0f5132 !important;
    }

    /* COUPON LINK: yellow visual marker + darker label */
    .coupon-link {
        color: #343434;
        font-size: 15px;
        font-weight: 600;
        position: relative;
        padding-left: 14px; /* space for yellow marker */
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: color .2s ease, transform .15s ease;
    }

        /* small vertical yellow bar to the left */
        .coupon-link::before {
            content: "";
            display: block;
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 8px;
            height: 28px;
            background: #ffd814; /* strong yellow */
            border-radius: 3px;
            box-shadow: 0 2px 6px rgba(255,216,20,0.12);
            transition: width .15s ease, background .15s ease, box-shadow .15s ease;
        }

        .coupon-link:hover {
            color: #1f1f1f;
            transform: translateX(3px);
        }

            .coupon-link:hover::before {
                background: #ffcf2a;
                width: 10px;
                box-shadow: 0 4px 10px rgba(255,207,42,0.14);
            }

    /* make coupon input and apply button align with yellow theme */
    .coupon-input {
        border-radius: 0;
    }

    .btn-outline-warning {
        border-color: #ffd814;
        color: #222;
    }

        .btn-outline-warning:hover {
            background: #ffd814;
            color: #000;
            border-color: #ffd814;
        }

    /* Dark Mode overrides (consistent, fully dark basket) */
    :root[data-theme="dark"] .main-cart-container,
    body.dark-mode .main-cart-container {
        background-color: #0b0b0b !important;
        color: #f5f5f5 !important;
    }

    :root[data-theme="dark"] .cart-card,
    body.dark-mode .cart-card {
        background-color: #0b0b0b !important;
        color: #f5f5f5 !important;
        border-color: rgba(255,255,255,0.06) !important;
        box-shadow: none !important;
    }

    /* keep the yellow marker visible in dark mode (slightly brighter) */
    :root[data-theme="dark"] .coupon-link::before,
    body.dark-mode .coupon-link::before {
        background: #ffd814 !important;
        box-shadow: 0 4px 12px rgba(255,216,20,0.16) !important;
    }

    :root[data-theme="dark"] .text-muted-theme,
    body.dark-mode .text-muted-theme {
        color: #bdbdbd !important; /* readable but lighter in dark */
    }

    :root[data-theme="dark"] .qty-btn,
    body.dark-mode .qty-btn {
        background-color: #1b1b1b !important;
        color: #fff !important;
        border: 1px solid #333 !important;
    }

    :root[data-theme="dark"] .qty-input,
    body.dark-mode .qty-input {
        background-color: #151515 !important;
        color: #fff !important;
        border: 1px solid #333 !important;
    }

    /* ensure product-img border visible in dark */
    :root[data-theme="dark"] .product-img,
    body.dark-mode .product-img {
        border-color: rgba(255,255,255,0.06) !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Expose current currency to JS for fallback formatting
            window.currentCurrency = '@CurrencyService.GetCurrentCurrency().ToString()';

            let appliedCoupon = null;
            let variantIdToDelete = null;

            function localeForCurrency(curr) {
                switch (curr) {
                    case 'AZN': return 'az-AZ';
                    case 'RUB': return 'ru-RU';
                    default: return 'en-US';
                }
            }

            function formatCurrency(amount) {
                const curr = window.currentCurrency || 'USD';
                const locale = localeForCurrency(curr);
                try {
                    return new Intl.NumberFormat(locale, {
                        style: 'currency', currency: curr
                    }).format(amount);
                } catch {
                    return amount.toFixed(2) + ' ' + curr;
                }
            }

            $(document).on('change', '.qty-input', function() {
                const variantId = $(this).data('variant-id');
                const newQty = parseInt($(this).val(), 10);

                if (newQty < 1 || isNaN(newQty)) {
                    $(this).val(1);
                    return;
                }

                $.get('@Url.Action("GetBasket", "Basket")', data => {
                    const currentItem = data.items.find(x => x.productVariantId === variantId);
                    if(currentItem) {
                        const diff = newQty - currentItem.quantity;
                        if(diff !== 0) changeQuantity(variantId, diff);
                    }
                });
            });

            $(document).on('click', '.qty-increase', function () {
                changeQuantity($(this).data('variant-id'), 1);
            });

            $(document).on('click', '.qty-decrease', function () {
                const variantId = $(this).data('variant-id');
                const $input = $(`.qty-input[data-variant-id="${variantId}"]`);
                if (parseInt($input.val(), 10) > 1) {
                    changeQuantity(variantId, -1);
                } else {
                    showDeleteConfirmation(variantId, $(this).closest('.cart-item').find('h5').text());
                }
            });

            function changeQuantity(variantId, change) {
                $.post('@Url.Action("ChangeQuantity", "Basket")', { productVariantId: variantId, change: change })
                .done(res => {
                    const item = res?.basketViewModel?.items?.find(x => x.productVariantId === variantId);
                    if (item) {
                        $(`.qty-input[data-variant-id="${variantId}"]`).val(item.quantity);
                        const formatted = item.totalPriceFormatted || formatCurrency(item.totalPrice);
                        $(`.cart-item[data-variant-id="${variantId}"] .item-price`).html(formatted);
                        updateTotals();
                    }
                });
            }

            $(document).on('click', '.btn-delete-text', function () {
                variantIdToDelete = $(this).data('variant-id');
                $('#productNameToDelete').text($(this).data('product-name'));
                $('#deleteConfirmModal').modal('show');
            });

            $('#confirmDeleteBtn').on('click', function () {
                $.post('@Url.Action("Remove", "Basket")', { id: variantIdToDelete }).done(() => location.reload());
            });

            function updateTotals() {
                $.get('@Url.Action("GetBasket", "Basket")', data => {
                    $('#cart-items-count, #cart-items-count-bottom').text(data.totalCount);
                    $('.header__cart-count').text(data.totalCount || 0);

                    if (data.discount) {
                        $('#discount-amount').html(data.discount.discountAmountFormatted || formatCurrency(data.discount.discountAmountNumeric));
                        const html = `<span class="text-decoration-line-through text-muted-theme me-2">${data.discount.originalTotalFormatted || formatCurrency(data.discount.originalTotalNumeric)}</span>${data.discount.finalPriceFormatted || formatCurrency(data.discount.finalPriceNumeric)}`;
                        $('#cart-subtotal, #cart-subtotal-bottom').html(html);
                        $('#discount-info').removeClass('d-none');
                        $('#discount-code').text(data.discount.code);
                        $('#discount-percentage').text(data.discount.salePercentage);
                        appliedCoupon = { code: data.discount.code, salePercentage: data.discount.salePercentage };
                    } else {
                        $('#discount-info').addClass('d-none');
                        $('#cart-subtotal, #cart-subtotal-bottom').html(data.totalPriceFormatted || formatCurrency(data.totalPrice));
                        appliedCoupon = null;
                    }
                });
            }

            $('#coupon-form').on('submit', function (e) {
                e.preventDefault();
                const code = $('#coupon-code-input').val().trim();
                if (!code) return;

                $.ajax({
                    url: '@Url.Action("ApplyDiscount", "Basket")',
                    type: 'POST',
                    data: { discountCode: code },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (res) {
                        if (res.success) {
                            appliedCoupon = { code: code, salePercentage: res.salePercentage, discountAmountNumeric: res.discountAmountNumeric, finalPriceNumeric: res.finalPriceNumeric };

                            $('#discount-info').removeClass('d-none');
                            $('#discount-code').text(code);
                            $('#discount-percentage').text(res.salePercentage);
                            $('#discount-amount').html(res.discountAmountFormatted || formatCurrency(res.discountAmountNumeric));

                            const original = res.originalTotalFormatted || formatCurrency(res.originalTotalNumeric || res.originalTotal || 0);
                            const final = res.finalPriceFormatted || formatCurrency(res.finalPriceNumeric || res.finalPrice || 0);
                            $('#cart-subtotal, #cart-subtotal-bottom').html(`<span class="text-decoration-line-through text-muted-theme me-2">${original}</span>${final}`);

                            updateTotals();
                            $('#couponCollapse').collapse('hide');
                        } else {
                            alert(res.message || 'Invalid or expired discount code');
                        }
                    },
                    error: function () {
                        alert('Error applying discount');
                    }
                });
            });

            $('#remove-coupon').on('click', function () {
                appliedCoupon = null;
                $('#discount-info').addClass('d-none');
                $.post('@Url.Action("RemoveDiscount", "Basket")', () => updateTotals());
            });

            updateTotals();

            function showDeleteConfirmation(variantId, productName) {
                variantIdToDelete = variantId;
                $('#productNameToDelete').text(productName);
                $('#deleteConfirmModal').modal('show');
            }
        });
    </script>
}