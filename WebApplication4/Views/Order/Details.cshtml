@using ECommerceCoza.DAL.DataContext.Entities
@using EcommerceCoza.BLL.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject WebApplication4.Services.ICurrencyService CurrencyService
@model OrderViewModel

<main class="pt-90" style="padding-top: 0px;">
    <div class="mb-4 pb-4"></div>
    <section class="my-account container">
        <h2 class="page-title">@Localizer["OrderDetails"]</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div class="row">
            <div class="col-12">
                <div class="wg-box mt-5 mb-5">
                    <div class="row mb-3">
                        <div class="col-6">
                            <h5>@Localizer["OrderedDetails"]</h5>
                        </div>
                        <div class="col-6 text-end">
                            <a class="btn btn-sm btn-secondary" asp-action="Index">@Localizer["Back"]</a>

                            @if ((User.Identity?.IsAuthenticated ?? false) &&
                                                        (Model.OrderStatus != OrderStatus.Cancelled && Model.OrderStatus != OrderStatus.Completed))
                            {
                                <form asp-action="Cancel" asp-controller="Order" method="post" class="d-inline ms-2" onsubmit="return confirm('Are you sure you want to cancel this order?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card border shadow-sm">
                                <div class="card-body p-3">
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Localizer["OrderNo"]</small>
                                        <strong>#@Model.Id</strong>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Localizer["OrderDate"]</small>
                                        <span>@Model.FormattedCreatedAt</span>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@Localizer["OrderStatus"]</small>
                                        <span class="badge @(Model.OrderStatus == OrderStatus.Completed ? "bg-success" : Model.OrderStatus == OrderStatus.Cancelled ? "bg-danger" : "bg-warning")">
                                            @Model.OrderStatus
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border shadow-sm">
                                <div class="card-body p-3">
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Localizer["Mobile"]</small>
                                        <span>@(Model.Address?.Phone ?? "N/A")</span>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Localizer["DeliveredDate"]</small>
                                        <span>@(string.IsNullOrEmpty(Model.FormattedDeliveredDate) ? "Pending" : Model.FormattedDeliveredDate)</span>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@Localizer["CanceledDate"]</small>
                                        <span>@(string.IsNullOrEmpty(Model.FormattedCanceledDate) ? "-" : Model.FormattedCanceledDate)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="wg-box card shadow-sm p-4">
                    <h5 class="mb-3">@Localizer["OrderedItems"]</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle border-top">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width: 300px;">@Localizer["Name"]</th>
                                    <th class="text-center" style="width: 120px;">@Localizer["Price"]</th>
                                    <th class="text-center" style="width: 100px;">@Localizer["Quantity"]</th>
                                    <th class="text-center" style="width: 120px;">@Localizer["Color"]</th>
                                    <th class="text-end" style="width: 140px;">@Localizer["Total"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    var itemPrice = item.ProductVariant?.Priced ?? 0;
                                    var lineTotal = itemPrice * item.Quantity;

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="~/images/products/@item.ProductVariant?.CoverImageName"
                                                     alt="@item.ProductVariant?.ProductName"
                                                     class="me-3 rounded shadow-sm"
                                                     style="width: 70px; height: 70px; object-fit: cover;">
                                                <div>
                                                    <div class="fw-bold text-dark">@item.ProductVariant?.ProductName</div>
                                                    @if (!string.IsNullOrEmpty(item.ProductVariant?.Size))
                                                    {
                                                        <small class="text-muted d-block">Size: <span class="text-dark">@item.ProductVariant?.Size</span></small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-medium">
                                            @CurrencyService.Format(itemPrice)
                                        </td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill bg-light text-dark border">@item.Quantity</span>
                                        </td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.ProductVariant?.ColorName))
                                            {
                                                <span class="text-muted">@item.ProductVariant.ColorName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">N/A</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold text-primary">
                                            @CurrencyService.Format(lineTotal)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="wg-box mt-4">
                    <h5 class="mb-3">@Localizer["ShippingAddress"]</h5>
                    <div class="card border-0 bg-light p-3">
                        <p class="mb-1 fw-bold">@Model.Address?.FirstName @Model.Address?.LastName</p>
                        @if (!string.IsNullOrEmpty(Model.Address?.Company))
                        {
                            <p class="mb-1 text-muted small">@Model.Address?.Company</p>
                        }
                        <p class="mb-1">@Model.Address?.Adress</p>
                        <p class="mb-1">@Model.Address?.City, @Model.Address?.Country</p>
                        <p class="mb-2">@Localizer["PostalCode"]: @Model.Address?.PostalCode</p>
                        <hr class="my-2">
                        <p class="mb-0">
                            <i class="fas fa-phone-alt me-2 text-secondary"></i>
                            <strong>@(Model.Address?.Phone ?? "N/A")</strong>
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="wg-box mt-4">
                    <h5 class="mb-3">@Localizer["Transactions"]</h5>
                    <div class="card border-0 bg-light p-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>@Localizer["Subtotal"]</span>
                            <span class="fw-medium">@CurrencyService.Format(Model.TotalPrice)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 border-bottom pb-2">
                            <span class="text-danger">@Localizer["Discount"]</span>
                            <span class="text-danger">-@CurrencyService.Format(Model.DiscountAmount)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 mt-2">
                            <strong class="fs-5">@Localizer["Total"]</strong>
                            <strong class="fs-5 text-primary">@CurrencyService.Format(Model.EndPrice)</strong>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">@Localizer["PaymentMethod"]</span>
                            <span class="fw-bold">@Model.PaymentMethod</span>
                        </div>
                        <div class="d-flex justify-content-between small mt-1">
                            <span class="text-muted">@Localizer["Status"]</span>
                            <span class="text-uppercase fw-bold text-info">@Model.OrderStatus</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
</main>