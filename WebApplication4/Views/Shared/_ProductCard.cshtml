@model EcommerceCoza.BLL.ViewModels.ProductViewModel
@inject WebApplication4.Services.ICurrencyService CurrencyService
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var firstVariant = Model.ProductVariants.FirstOrDefault();

    // Deduplicate color keys (prefer ColorId, else color hex, else color name)
    var uniqueColors = Model.ProductVariants
        .Select(v => new
        {
            Variant = v,
            Key = v.ColorId > 0
                ? $"id_{v.ColorId}"
                : (!string.IsNullOrEmpty(v.ColorHexCode) ? $"hex_{v.ColorHexCode}" : $"name_{v.ColorName}")
        })
        .GroupBy(x => x.Key)
        .Select(g => g.First().Variant)
        .ToList();

    // Build product color tokens: prefer numeric Id (as string), otherwise use hex or name (lowercase)
    var productColorTokens = uniqueColors
        .Select(c => c.ColorId > 0
            ? c.ColorId.ToString()
            : (!string.IsNullOrEmpty(c.ColorHexCode) ? c.ColorHexCode.ToLower() : (!string.IsNullOrEmpty(c.ColorName) ? c.ColorName.ToLower() : "")))
        .Where(s => !string.IsNullOrEmpty(s))
        .Distinct()
        .ToList();

    var productSizes = Model.ProductVariants.Where(v => !string.IsNullOrEmpty(v.Size)).Select(v => v.Size).Distinct().ToList();

    var lowestPrice = Model.ProductVariants.Any()
        ? Model.ProductVariants.Min(v => v.SalePrice ?? v.Price)
        : Model.BasePrice;
    var hasVariantDiscount = firstVariant?.HasDiscount ?? false;

    int discountPercent = 0;
    if (hasVariantDiscount && firstVariant != null)
    {
        discountPercent = (int)Math.Round((1 - (firstVariant.SalePrice.Value / firstVariant.Price)) * 100);
    }

    var displayColorLimit = 5;
    var displayColors = uniqueColors.Take(displayColorLimit).ToList();
    var remainingColorCount = Math.Max(0, uniqueColors.Count - displayColorLimit);

    // choose initial image filename (cover preferred, else first additional image, else placeholder)
    string initialImage = "product-placeholder.jpg";
    if (firstVariant != null)
    {
        if (!string.IsNullOrEmpty(firstVariant.CoverImageName))
        {
            initialImage = firstVariant.CoverImageName;
        }
        else if (firstVariant.ImageNames != null && firstVariant.ImageNames.Any())
        {
            initialImage = firstVariant.ImageNames.First();
        }
    }
}

<div class="product-card-wrapper"
     data-product-id="@Model.Id"
     data-product-category="@Model.CategoryId"
     data-product-brand="@Model.BrandId"
     data-product-colors="@string.Join(",", productColorTokens)"
     data-product-sizes="@string.Join(",", productSizes)"
     data-product-price="@lowestPrice"
     data-product-name="@Model.Name"
     data-product-date="@Model.Id">
    <div class="product-card mb-3 mb-md-4 mb-xxl-5">
        <div class="pc__img-wrapper position-relative">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.DetailsUrl" class="d-block">
                <img loading="lazy"
                     src="~/images/products/@initialImage"
                     width="330"
                     height="400"
                     alt="@Model.Name"
                     class="pc__img main-product-image">
            </a>

            @if (hasVariantDiscount)
            {
                <div class="pc-labels position-absolute top-0 start-0" style="z-index: 5;">
                    <span class="pc-label pc-label_sale d-block text-white"
                          style="background: #dc3545; font-size: 14px; padding: 8px 12px; font-weight: 700; border-radius: 0; letter-spacing: 0.5px;">
                        -@discountPercent%
                    </span>
                </div>
            }

            @if (firstVariant != null && firstVariant.Quantity > 0)
            {
                <button class="pc__atc btn anim_appear-bottom btn position-absolute border-0 text-uppercase fw-medium js-add-cart"
                        data-variant-id="@firstVariant.Id"
                        title="@Localizer["AddToCart"]">
                    @Localizer["AddToCart"]
                </button>
            }
            else
            {
                <div class="pc__atc btn position-absolute border-0 text-uppercase fw-medium bg-secondary text-white" style="cursor: not-allowed;">
                    @Localizer["OutOfStock"]
                </div>
            }
        </div>

        <div class="pc__info position-relative">
            <p class="pc__category">
                @if (Model.Brand != null)
                {
                    <span class="fw-medium text-primary">@Model.Brand.Name</span>
                    @if (Model.Category != null)
                    {
                        <span class="text-muted"> • </span>
                    }
                }
                @if (Model.Category != null)
                {
                    <span>@Model.Category.Name</span>
                }
            </p>
            <h6 class="pc__title">
                <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.DetailsUrl">@Model.Name</a>
            </h6>

            <div class="product-card__price">
                @if (hasVariantDiscount)
                {
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="money price text-danger fw-semibold price-current" style="font-size: 1.15rem;">
                            @CurrencyService.Format(firstVariant.SalePrice.Value)
                        </span>
                        <span class="money price text-decoration-line-through text-muted price-old" style="font-size: 0.875rem;">
                            @CurrencyService.Format(firstVariant.Price)
                        </span>
                    </div>
                }
                else
                {
                    <span class="money price price-current" style="font-size: 1.15rem;">@CurrencyService.Format(lowestPrice)</span>
                }
            </div>

            @if (uniqueColors.Any())
            {
                <div class="d-flex align-items-center mt-2 swatch-row">
                    @for (int i = 0; i < displayColors.Count; i++)
                    {
                        var variant = displayColors[i];
                        var cover = variant.CoverImageName ?? "";
                        var firstImg = (variant.ImageNames != null && variant.ImageNames.Any()) ? variant.ImageNames.First() : "";
                        var price = variant.Price;
                        var sale = variant.SalePrice;
                        var qty = variant.Quantity;
                        if (!string.IsNullOrEmpty(variant.ColorHexCode))
                        {
                            <a href="#"
                               class="swatch-color pc__swatch-color"
                               data-variant-id="@variant.Id"
                               data-cover-image="@cover"
                               data-first-image="@firstImg"
                               data-price="@price"
                               data-sale-price="@(sale.HasValue? sale.Value.ToString() : "")"
                               data-qty="@qty"
                               title="@variant.ColorName"
                               style="background-color: @variant.ColorHexCode;"
                               aria-label="@variant.ColorName"></a>
                        }
                        else if (!string.IsNullOrEmpty(variant.ColorIconName))
                        {
                            <a href="#"
                               class="swatch-color pc__swatch-color"
                               data-variant-id="@variant.Id"
                               data-cover-image="@cover"
                               data-first-image="@firstImg"
                               data-price="@price"
                               data-sale-price="@(sale.HasValue? sale.Value.ToString() : "")"
                               data-qty="@qty"
                               title="@variant.ColorName">
                                <img src="~/Uploads/@variant.ColorIconName" alt="@variant.ColorName" style="width:22px;height:22px;border-radius:50%;" />
                            </a>
                        }
                        else
                        {
                            <a href="#"
                               class="swatch-color pc__swatch-color text-muted"
                               data-variant-id="@variant.Id"
                               data-cover-image="@cover"
                               data-first-image="@firstImg"
                               data-price="@price"
                               data-sale-price="@(sale.HasValue? sale.Value.ToString() : "")"
                               data-qty="@qty"
                               title="@variant.ColorName"
                               style="display:inline-block;width:22px;height:22px;border-radius:50%;background:#f0f0f0;text-align:center;line-height:22px;">
                                @(!string.IsNullOrEmpty(variant.ColorName) ? variant.ColorName.Substring(0, 1) : "")
                            </a>
                        }
                    }

                    @if (remainingColorCount > 0)
                    {
                        <span class="text-secondary small ms-1">+@remainingColorCount</span>
                    }
                </div>
            }

            <button class="pc__btn-wl position-absolute top-0 end-0 bg-transparent border-0 js-add-wishlist"
                    data-product-id="@Model.Id"
                    title="@Localizer["AddToWishlist"]">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <use href="#icon_heart" />
                </svg>
            </button>

            @if (firstVariant != null && firstVariant.Quantity == 0)
            {
                <div class="pc-labels position-absolute top-0 start-0">
                    <span class="pc-label pc-label_sale d-block text-white bg-danger">@Localizer["OutOfStock"]</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .product-card__price .text-danger {
        color: #dc3545 !important;
        font-weight: 600;
    }

    .product-card__price {
        margin-top: 0.25rem;
        line-height: 1.2;
    }

    .pc-labels {
        z-index: 5;
    }

    .pc-label_sale {
        box-shadow: 0 2px 6px rgba(220, 53, 69, 0.3);
    }

    .pc__swatch-color {
        display: inline-block;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid #fff;
        margin-right: 6px;
        cursor: pointer;
        box-shadow: 0 0 0 3px rgba(244,230,0,0.25) inset;
        vertical-align: middle;
    }

        .pc__swatch-color.active {
            outline: 2px solid #333;
            transform: translateY(-1px);
        }
</style>

<script>
    (function ($) {
        $(document).on('click', '.pc__swatch-color', function (e) {
            e.preventDefault();
            var $sw = $(this);
            var $card = $sw.closest('.product-card-wrapper');

            // mark active
            $card.find('.pc__swatch-color').removeClass('active');
            $sw.addClass('active');

            // update main image (prefer cover image, fallback to first-image, fallback to placeholder)
            var cover = $sw.data('cover-image') || '';
            var firstImg = $sw.data('first-image') || '';
            var imgFile = cover || firstImg || 'product-placeholder.jpg';
            var $img = $card.find('.main-product-image').first();
            $img.attr('src', '/images/products/' + imgFile);

            // update add-to-cart variant id
            var variantId = $sw.data('variant-id');
            var $atc = $card.find('.js-add-cart').first();
            if (variantId && $atc.length) {
                $atc.attr('data-variant-id', variantId);
            }

            // update price display (if price data present)
            var price = $sw.data('price');
            var sale = $sw.data('sale-price');
            var $priceContainer = $card.find('.product-card__price .price-current').first();
            var $priceOld = $card.find('.product-card__price .price-old').first();
            if ($priceContainer.length && (price !== undefined && price !== null)) {
                if (sale && sale !== '') {
                    $card.find('.product-card__price').html('<div class="d-flex align-items-center gap-2 mb-1"><span class="money price text-danger fw-semibold price-current" style="font-size:1.15rem;">' + '@CurrencyService.GetSymbol() ' + parseFloat(sale).toFixed(2) + '</span><span class="money price text-decoration-line-through text-muted price-old" style="font-size:0.875rem;">' + '@CurrencyService.GetSymbol() ' + parseFloat(price).toFixed(2) + '</span></div>');
                } else {
                    $card.find('.product-card__price').html('<span class="money price price-current" style="font-size:1.15rem;">' + '@CurrencyService.GetSymbol() ' + parseFloat(price).toFixed(2) + '</span>');
                }
            }
        });

        // mark first visible swatch active on load and ensure image matches
        $(function () {
            $('.product-card-wrapper').each(function () {
                var $card = $(this);
                var $first = $card.find('.pc__swatch-color').first();
                if ($first.length) {
                    $first.addClass('active');

                    // synchronize image with active swatch
                    var cover = $first.data('cover-image') || '';
                    var firstImg = $first.data('first-image') || '';
                    var imgFile = cover || firstImg || 'product-placeholder.jpg';
                    $card.find('.main-product-image').attr('src', '/images/products/' + imgFile);

                    // ensure add-to-cart uses this variant id
                    var variantId = $first.data('variant-id');
                    if (variantId) {
                        $card.find('.js-add-cart').attr('data-variant-id', variantId);
                    }
                }
            });
        });
    })(jQuery);
</script>