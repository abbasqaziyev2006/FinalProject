@using EcommerceCoza.BLL.ViewModels
@model IEnumerable<ReviewViewModel>

<main class="pt-90">
    <div class="mb-5 pb-5"></div>
    <section class="my-account container">
        <h2 class="page-title mt-4 mb-5">My Account</h2>
        <div class="row">
            <div class="col-lg-3">
                <ul class="account-nav">
                    <li><a asp-controller="Account" asp-action="Index" class="menu-link menu-link_us-s">Dashboard</a></li>
                    <li><a asp-controller="Order" asp-action="Index" class="menu-link menu-link_us-s">Orders</a></li>
                    <li><a asp-controller="Address" asp-action="Index" class="menu-link menu-link_us-s">Addresses</a></li>
                    <li><a asp-controller="Account" asp-action="Edit" class="menu-link menu-link_us-s">Account Details</a></li>
                    <li><a asp-controller="Wishlist" asp-action="Index" class="menu-link menu-link_us-s">Wishlist</a></li>
                    <li><a asp-controller="Account" asp-action="Reviews" class="menu-link menu-link_us-s active">My Reviews</a></li>
                    <li><a asp-controller="Account" asp-action="Logout" class="menu-link menu-link_us-s">Logout</a></li>
                </ul>
            </div>
            <div class="col-lg-9">
                <div class="page-content my-account__reviews">
                    <h4 class="mb-4">Your Reviews</h4>
                    @if (!Model.Any())
                    {
                        <div class="alert alert-secondary">You have not submitted any reviews yet.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Rating</th>
                                        <th>Comment</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var review in Model)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Product" asp-action="Details" asp-route-id="@review.ProductId">
                                                    @review.ProductName
                                                </a>
                                            </td>
                                            <td>
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fa fa-star @(i <= review.Rating ? "text-warning" : "text-muted")"></i>
                                                }
                                            </td>
                                            <td>@review.Comment</td>
                                            <td>@review.CreatedAt.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <a asp-controller="Review" asp-action="Edit" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                                <form asp-controller="Review" asp-action="Delete" method="post" style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@review.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this review?');">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</main>